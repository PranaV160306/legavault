# LegaVault Objective 1 Environment Configuration Template
# DO NOT put real secrets in this file. Copy to .env and configure values.

SECRET_KEY=change_this_to_a_random_jwt_secret_key_32_characters_minimum
AES_SECRET_KEY=change_this_to_a_64_hex_char_master_key_or_long_random_passphrase
DATABASE_URL=sqlite:///./legavault_secure.db
VAULT_DIR=./storage/vault
OTP_DEV_MODE=True
OTP_EXPIRE_MINUTES=5
OTP_COOLDOWN_SECONDS=60
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ==============================================================================
# LegaVault - Environment Configuration Template (.env.example)
# OBJECTIVE 1: Secure Document Transfer, AES-256-GCM, RBAC, OTP & Audit Logs
# ==============================================================================
# IMPORTANT: DO NOT PUT REAL SECRETS IN THIS FILE.
# Copy this file to .env and change all secrets to strong random values.

# 1. JWT Authentication Secret Key
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_64_random_hex_characters

# 2. AES-256-GCM Master Encryption Key
# 64 hexadecimal characters representing a 32-byte (256-bit) cryptographic key
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AES_SECRET_KEY=replace_with_64_random_hex_characters

# Required to create a lawyer account from the registration page.
LAWYER_REGISTRATION_CODE=replace_with_a_long_random_setup_code

# 3. Database URL (SQLite)
DATABASE_URL=sqlite:///./backend/legavault_secure.db

# 4. Storage Vault Path (Isolated directory for AES encrypted files)
VAULT_DIR=./backend/storage/vault

# 5. Two-Factor Authentication (OTP) Configuration
OTP_DEV_MODE=True
OTP_EXPIRE_MINUTES=5
OTP_COOLDOWN_SECONDS=60

# Real email delivery: set OTP_DEV_MODE=False and fill these SMTP values.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_SSL=False
# Use a provider app password/API SMTP credential, never your normal mailbox password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=False

# 6. Session & Token Expiry
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 7. Optional Gemini API access for AI legal Q&A in the Flask app
# Keep this key private. Add the real value to your local .env file only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash


# Comma-separated frontend origins allowed to make credentialed API requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
